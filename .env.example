# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=FOMS
APP_TIMEZONE=Asia/Shanghai

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_DB=foms
POSTGRES_USER=foms
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://foms:replace-me@localhost:5432/foms

# Redis (introduced when background jobs are implemented)
REDIS_URL=redis://localhost:6379/0

# Object storage (configure only when enabled)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# AI provider: configure only after company approval.
AI_PROVIDER=
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
